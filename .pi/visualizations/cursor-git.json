{
  "sourceUrl": "https://cursor.com/blog/git-at-any-scale",
  "checks": [
    "source-fidelity",
    "text-visible",
    "text-not-overlapping",
    "content-not-clipped",
    "connections-clear",
    "controls-work",
    "responsive-layout",
    "theme-contrast",
    "keyboard-access",
    "reduced-motion",
    "no-console-errors",
    "mcp-only-authoring"
  ],
  "captures": [
    {
      "key": "light-wide",
      "theme": "light",
      "width": 1440,
      "height": 1000,
      "motion": "no-preference",
      "interaction": "keyboard-and-pointer"
    },
    {
      "key": "dark-wide",
      "theme": "dark",
      "width": 1440,
      "height": 1000,
      "motion": "no-preference",
      "interaction": "keyboard-and-pointer"
    },
    {
      "key": "light-narrow",
      "theme": "light",
      "width": 390,
      "height": 844,
      "motion": "no-preference",
      "interaction": "keyboard-and-pointer"
    },
    {
      "key": "dark-narrow",
      "theme": "dark",
      "width": 390,
      "height": 844,
      "motion": "no-preference",
      "interaction": "keyboard-and-pointer"
    },
    {
      "key": "reduced-motion",
      "theme": "light",
      "width": 1440,
      "height": 1000,
      "motion": "reduce",
      "interaction": "keyboard-and-pointer"
    }
  ],
  "graphics": [
    {
      "id": "kv-history-walk",
      "title": "Remote key/value Git history walk",
      "selector": ".git-kv-walk-demo",
      "states": [
        {
          "key": "initial",
          "label": "Newest commit ref before remote reads",
          "advanceMs": 0
        },
        {
          "key": "reading",
          "label": "Object requests and responses in progress",
          "advanceMs": 2200
        },
        {
          "key": "history",
          "label": "History walk after more round trips",
          "advanceMs": 6500
        }
      ],
      "checks": [
        "objects-and-round-trips-visible",
        "reference-discovery-follows-responses",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "packfile-history-walk",
      "title": "Local packfile object walk",
      "selector": ".git-object-walk-demo",
      "states": [
        {
          "key": "initial",
          "label": "Commit DAG and packfile before reading",
          "advanceMs": 0
        },
        {
          "key": "reading",
          "label": "Highlighted commit and packfile ranges",
          "advanceMs": 2200
        },
        {
          "key": "history",
          "label": "History scroll and subsequent object reads",
          "advanceMs": 6500
        }
      ],
      "checks": [
        "active-commit-and-byte-range-correspond",
        "delta-base-reads-shown",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "three-phase-commit",
      "title": "Three-phase commit and participant failures",
      "selector": ".git-3pc-protocol-demo",
      "states": [
        {
          "key": "initial",
          "label": "Default quorum with participant 3 offline"
        },
        {
          "key": "restored",
          "label": "All nodes restored",
          "restoreAll": true
        },
        {
          "key": "participant-offline",
          "label": "Participant 1 disabled",
          "restoreAll": true,
          "offline": "PARTICIPANT 1"
        },
        {
          "key": "coordinator-offline",
          "label": "Coordinator disabled",
          "restoreAll": true,
          "offline": "COORDINATOR"
        }
      ],
      "checks": [
        "online-offline-status-visible",
        "quorum-and-three-phases-visible",
        "restore-all-operates",
        "normal-playback-progresses-model",
        "controls-affect-live-simulation"
      ]
    },
    {
      "id": "spokes-replication",
      "title": "Spokes replica count and latency",
      "selector": ".git-3pc-replication-demo",
      "states": [
        {
          "key": "default",
          "label": "Default replica count and latency"
        },
        {
          "key": "many-replicas",
          "label": "Replica slider at maximum",
          "sliders": {
            "Replicas": "End"
          }
        },
        {
          "key": "high-latency",
          "label": "Latency slider at maximum",
          "sliders": {
            "One-way latency": "End"
          }
        },
        {
          "key": "progressing",
          "label": "Upload and three-phase commit progressing",
          "sliders": {
            "Playback speed": "End"
          },
          "advanceMs": 900
        }
      ],
      "checks": [
        "replica-and-latency-controls-work",
        "elapsed-time-and-ack-count-readable",
        "normal-playback-progresses-model",
        "controls-affect-live-simulation"
      ]
    },
    {
      "id": "wal-push",
      "title": "WAL push and conditional index update",
      "selector": ".git-wal-push-demo",
      "states": [
        {
          "key": "push",
          "label": "PUSH",
          "phase": "PUSH"
        },
        {
          "key": "index",
          "label": "INDEX",
          "phase": "INDEX"
        },
        {
          "key": "upload",
          "label": "UPLOAD",
          "phase": "UPLOAD"
        },
        {
          "key": "get",
          "label": "GET",
          "phase": "GET"
        },
        {
          "key": "lock",
          "label": "LOCK",
          "phase": "LOCK"
        },
        {
          "key": "put",
          "label": "PUT",
          "phase": "PUT"
        },
        {
          "key": "ref-txn",
          "label": "REF TXN",
          "phase": "REF TXN"
        }
      ],
      "checks": [
        "linearization-point-visible",
        "index-and-local-ref-transaction-distinct",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "wal-race",
      "title": "Concurrent WAL index update race",
      "selector": ".git-wal-race-demo",
      "states": [
        {
          "key": "upload",
          "label": "UPLOAD",
          "phase": "UPLOAD"
        },
        {
          "key": "race",
          "label": "RACE",
          "phase": "RACE"
        },
        {
          "key": "conflict",
          "label": "CONFLICT",
          "phase": "CONFLICT"
        },
        {
          "key": "refetch",
          "label": "REFETCH",
          "phase": "REFETCH"
        },
        {
          "key": "rebase",
          "label": "REBASE",
          "phase": "REBASE"
        },
        {
          "key": "retry",
          "label": "RETRY",
          "phase": "RETRY"
        },
        {
          "key": "done",
          "label": "DONE",
          "phase": "DONE"
        }
      ],
      "checks": [
        "winner-and-412-conflict-visible",
        "retry-uses-new-etag",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "wal-replication",
      "title": "WAL gossip replication and dropped datagrams",
      "selector": ".git-wal-replication-demo",
      "states": [
        {
          "key": "push",
          "label": "PUSH",
          "phase": "PUSH"
        },
        {
          "key": "commit",
          "label": "COMMIT",
          "phase": "COMMIT"
        },
        {
          "key": "gossip",
          "label": "GOSSIP",
          "phase": "GOSSIP"
        },
        {
          "key": "replicate",
          "label": "REPLICATE",
          "phase": "REPLICATE"
        },
        {
          "key": "fetch",
          "label": "FETCH",
          "phase": "FETCH"
        },
        {
          "key": "get-304",
          "label": "GET \u00b7 304",
          "phase": "GET \u00b7 304"
        },
        {
          "key": "serve",
          "label": "SERVE",
          "phase": "SERVE"
        },
        {
          "key": "dropped-gossip",
          "label": "Gossip datagram dropped",
          "dropGossip": true,
          "phase": "GOSSIP \u2715"
        },
        {
          "key": "get-200",
          "label": "Conditional GET sees changed index after dropped gossip",
          "dropGossip": true,
          "phase": "GET \u00b7 200"
        },
        {
          "key": "catch-up",
          "label": "Conditional GET catches up after dropped gossip",
          "dropGossip": true,
          "phase": "CATCH UP"
        },
        {
          "key": "serve-after-catch-up",
          "label": "Fetch served after replica catches up",
          "dropGossip": true,
          "phase": "SERVE"
        }
      ],
      "checks": [
        "delivered-and-dropped-gossip-paths",
        "conditional-get-304-versus-200",
        "stale-replica-catches-up-before-serve",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "wal-scaling",
      "title": "Traffic-scaled replicas and garbage collection",
      "selector": ".git-wal-scale-demo",
      "states": [
        {
          "key": "initial",
          "label": "Object store, cluster nodes and clients",
          "advanceMs": 0
        },
        {
          "key": "traffic",
          "label": "Push and pull traffic across replica lanes",
          "advanceMs": 2200
        },
        {
          "key": "rematerialization",
          "label": "Replica collection and on-demand rematerialization",
          "advanceMs": 6500
        }
      ],
      "checks": [
        "primary-dots-and-repository-colors-visible",
        "dashed-collected-replicas-distinct",
        "store-contains-opaque-wal-objects",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "wal-compaction",
      "title": "Incremental geometric WAL compaction",
      "selector": ".git-wal-compaction-demo",
      "states": [
        {
          "key": "initial",
          "label": "Packs and compaction frontier",
          "advanceMs": 0
        },
        {
          "key": "arrivals",
          "label": "Incoming packs and index updates",
          "advanceMs": 2200
        },
        {
          "key": "compaction",
          "label": "Later compaction cycle",
          "advanceMs": 6500
        },
        {
          "key": "base-fold",
          "label": "Subsequent geometric compaction cycle",
          "advanceMs": 14000
        }
      ],
      "checks": [
        "frontier-and-pack-checksums-readable",
        "source-of-truth-index-distinct",
        "increasing-sequence-numbers",
        "index-put-progress-visible",
        "normal-playback-progresses-model"
      ]
    },
    {
      "id": "clone-throughput",
      "title": "Clone throughput by replica count",
      "selector": ".git-replica-throughput > .builder-mobile-chart:nth-child(1)",
      "states": [
        {
          "key": "chart",
          "label": "Clone throughput by replica count"
        }
      ],
      "checks": [
        "axis-units-and-ticks-readable",
        "both-storage-series-visible",
        "use-captured-values-no-invented-data"
      ]
    },
    {
      "id": "push-throughput",
      "title": "Push throughput by replica count",
      "selector": ".git-replica-throughput > .builder-mobile-chart:nth-child(2)",
      "states": [
        {
          "key": "chart",
          "label": "Push throughput by replica count"
        }
      ],
      "checks": [
        "axis-units-and-ticks-readable",
        "both-storage-series-visible",
        "use-captured-values-no-invented-data"
      ]
    }
  ]
}
