{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whiteboard:visualization-report",
  "title": "Complete visualization inspection report",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": ["pass", "fail"]
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "screenshot": {
            "type": "string",
            "minLength": 1
          },
          "diagnostics": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["key", "screenshot", "diagnostics"],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "capture": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": ["pass", "fail", "not-reachable"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["capture", "rule", "result", "evidence", "observation"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["blocker", "major", "minor"]
          },
          "classification": {
            "enum": ["authored-misuse", "api-defect", "reference-uncertainty"]
          },
          "capture": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "classification",
          "capture",
          "rule",
          "evidence",
          "observed",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["verdict", "captures", "checks", "findings"],
  "additionalProperties": false
}
