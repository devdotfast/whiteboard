{
  "name": "@dev.fast/whiteboard-document",
  "version": "0.2.1",
  "description": "The whiteboard document: block schemas, the edit reducer and its summary, for any runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/review.git",
    "directory": "packages/whiteboard-document"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm -w exec tsc -p packages/whiteboard-document/tsconfig.json --noEmit"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dev.fast/json": "workspace:*",
    "micromark-util-types": "2.0.2",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
