{
  "name": "@dev.fast/whiteboard",
  "version": "0.2.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/whiteboard.git",
    "directory": "packages/review"
  },
  "bin": {
    "review": "./dist/cli.js",
    "whiteboard": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "onboarding.md",
    "dist",
    "instructions",
    "tutorial",
    "!tutorial/.bundle",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*test-utils*",
    "THIRD_PARTY_NOTICES.md",
    "vscode-server"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./sharing": {
      "types": "./dist/sharing/index.d.ts",
      "import": "./dist/sharing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm run build:workspace-deps",
    "build": "node --max-old-space-size=8192 node_modules/tsdown/dist/run.mjs",
    "build:tutorial-assets": "tsx scripts/build-tutorial-assets.ts",
    "ensure:tutorial-assets": "tsx scripts/ensure-tutorial-assets.ts",
    "check:tutorial": "tsx scripts/check-tutorial.ts",
    "build:workspace-deps": "pnpm --filter @dev.fast/json --filter @dev.fast/local-vcs --filter @dev.fast/review-protocol --filter @dev.fast/review-share-protocol --filter @dev.fast/trace-protocol --filter @dev.fast/trace-core build",
    "pretypecheck": "pnpm run ensure:tutorial-assets",
    "pretest": "pnpm run ensure:tutorial-assets",
    "pretest:node": "pnpm run ensure:tutorial-assets",
    "prepack": "pnpm run build",
    "start": "tsx src/cli.ts",
    "review": "tsx src/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:node": "vitest run --config vitest.config.ts --project shared-module-graph",
    "test:telemetry-privacy": "vitest run --config vitest.config.ts src/ui-telemetry-events.test.ts src/error-telemetry.test.ts",
    "typecheck": "pnpm -w exec tsc --noEmit -p packages/review",
    "test:integration:diffr": "pnpm run build:workspace-deps && vitest run --config vitest.integration.config.ts",
    "whiteboard": "tsx src/cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.84.0",
    "@agentclientprotocol/codex-acp": "2.0.0",
    "@agentclientprotocol/sdk": "1.5.1",
    "@dev.fast/diffr": "catalog:",
    "@hono/node-server": "2.0.12",
    "@img/sharp-wasm32": "0.35.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "commander": "14.0.3",
    "fuzzysort": "4.0.2",
    "hono": "4.13.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "pi-acp": "0.0.34",
    "pino": "10.3.1",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "yauzl": "3.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dev.fast/json": "workspace:*",
    "@dev.fast/local-vcs": "^0.1.0",
    "@dev.fast/review-protocol": "workspace:*",
    "@dev.fast/review-share-protocol": "workspace:*",
    "@dev.fast/trace-core": "workspace:*",
    "@dev.fast/trace-protocol": "workspace:*",
    "@types/node": "24.12.2",
    "@types/semver": "7.7.1",
    "@types/yauzl": "3.4.0",
    "micromark-extension-math": "3.1.0",
    "pino-pretty": "13.1.3",
    "tsdown": "0.22.14",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "intent": {
    "version": 1,
    "repo": "devdotfast/review",
    "docs": "packages/review/instructions/authoring.md"
  }
}
