---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  video?: string;
}

const { image, alt, caption, video } = Astro.props;
---

<figure class="demo-figure">
  {video ? (
    <video
      controls
      playsinline
      preload="none"
      poster={image.src}
      width={image.width}
      height={image.height}
      aria-label={alt}
    >
      <source src={video} type="video/mp4" />
      <a href={video}>Download the demonstration.</a>
    </video>
  ) : (
    <a href={image.src} aria-label={`Enlarge image: ${alt}`}>
      <Image src={image} alt={alt} loading="lazy" />
    </a>
  )}
  <figcaption>
    {caption}
    {!video && <a href={image.src}>Enlarge image</a>}
  </figcaption>
</figure>

<style>
  .demo-figure {
    margin-block: 1.5rem;
  }

  .demo-figure img,
  .demo-figure video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: #0c1017;
  }

  .demo-figure > a {
    display: block;
    cursor: zoom-in;
  }

  .demo-figure figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .demo-figure figcaption a {
    margin-inline-start: 0.5em;
    white-space: nowrap;
  }
</style>
