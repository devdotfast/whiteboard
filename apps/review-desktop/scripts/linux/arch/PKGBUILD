# Maintainer: dev.fast <support@dev.fast>
# Built by build-arch-package.sh from the release RPM for install.dev.fast.
case ${WHITEBOARD_CHANNEL:?} in
	stable) pkgname=whiteboard ;;
	preview) pkgname=whiteboard-preview ;;
	*) exit 1 ;;
esac
pkgver=${WHITEBOARD_VERSION:?}
pkgrel=${WHITEBOARD_REVISION:?}
pkgdesc='Guided code reviews with coding agents'
arch=('x86_64')
url='https://dev.fast/'
license=('MIT')
options=('!debug' '!strip' '!purge' '!zipman' 'staticlibs' 'libtool')
depends=(
	'alsa-lib' 'at-spi2-core' 'ca-certificates' 'cairo' 'curl' 'dbus' 'expat'
	'gcc-libs' 'glib2' 'glibc' 'gtk3' 'git' 'hicolor-icon-theme' 'krb5' 'libcups'
	'libnotify' 'libsecret' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext'
	'libxfixes' 'libxkbcommon' 'libxkbfile' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango'
	'systemd-libs' 'vulkan-icd-loader' 'xdg-utils' 'zlib'
)
makedepends=('rpm-tools')
optdepends=(
	'bubblewrap: sandbox agent commands'
	'python: run Python language extensions'
	'socat: sandbox agent commands'
)
source=("$pkgname-$pkgver-$pkgrel.x86_64.rpm")
noextract=("$pkgname-$pkgver-$pkgrel.x86_64.rpm")
# The RPM is built and verified earlier in the same release job.
sha256sums=('SKIP')

package() {
	set -o pipefail
	# Ship the RPM payload as-is. Do not run RPM scriptlets; pacman hooks refresh
	# the desktop and icon caches.
	rpm2cpio "$srcdir/$pkgname-$pkgver-$pkgrel.x86_64.rpm" | bsdtar -xpf - -C "$pkgdir"
	install -Dm644 "$pkgdir/usr/share/$pkgname/resources/app/LICENSE.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
