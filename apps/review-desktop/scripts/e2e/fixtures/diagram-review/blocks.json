[
  {
    "type": "sequence",
    "title": "Checkout to fulfillment",
    "actors": {
      "checkout": "Checkout API",
      "orderService": "Order service",
      "repository": "Orders repository",
      "queue": "Fulfillment queue",
      "worker": "Fulfillment worker",
      "shipping": "Shipping gateway"
    },
    "steps": [
      {
        "type": "step",
        "from": "checkout",
        "to": "orderService",
        "label": "Place order",
        "style": "call",
        "source": "head/src/api/checkout-api.ts#L12-L15"
      },
      {
        "type": "step",
        "from": "orderService",
        "to": "repository",
        "label": "Save order",
        "style": "call",
        "source": "head/src/orders/order-service.ts#L13-L29"
      },
      {
        "type": "step",
        "from": "repository",
        "to": "queue",
        "label": "Enqueue fulfillment",
        "style": "call",
        "source": "head/src/orders/orders-repository.ts#L9-L12"
      },
      {
        "type": "step",
        "from": "queue",
        "to": "worker",
        "label": "Deliver job",
        "style": "call",
        "source": "head/src/fulfillment/fulfillment-worker.ts#L13-L14"
      },
      {
        "type": "step",
        "from": "worker",
        "to": "shipping",
        "label": "Create shipment",
        "style": "call",
        "source": "head/src/fulfillment/fulfillment-worker.ts#L17-L19"
      }
    ]
  },
  {
    "type": "database_lens",
    "title": "Order storage",
    "actors": {
      "orderService": {
        "label": "Order service",
        "softwareMapPath": "orderService.application.orders"
      },
      "worker": {
        "label": "Fulfillment worker",
        "softwareMapPath": "orderService.fulfillment.worker"
      }
    },
    "stores": {
      "orderDatabase": {
        "label": "Order database",
        "storage": "relational",
        "softwareMapPath": "orderService.data.ordersDatabase",
        "collections": {
          "orders": {
            "label": "orders",
            "fields": {
              "customerId": {
                "label": "customerId",
                "dataType": "text",
                "example": "customer-42"
              },
              "totalCents": {
                "label": "totalCents",
                "dataType": "integer",
                "example": 12500
              },
              "status": {
                "label": "status",
                "dataType": "text",
                "example": "fulfilled"
              },
              "createdAt": {
                "label": "createdAt",
                "dataType": "timestamp",
                "example": "2026-08-10T12:00:00Z"
              }
            }
          }
        }
      }
    },
    "useCases": [
      {
        "label": "Create an order",
        "operations": [
          {
            "kind": "write",
            "store": "orderDatabase",
            "collection": "orders",
            "field": "status",
            "actor": "orderService",
            "label": "write pending order",
            "source": "head/src/orders/orders-repository.ts#L9-L12"
          }
        ]
      },
      {
        "label": "Fulfill an order",
        "operations": [
          {
            "kind": "write",
            "store": "orderDatabase",
            "collection": "orders",
            "field": "status",
            "actor": "worker",
            "label": "write fulfilled status",
            "source": "head/src/fulfillment/fulfillment-worker.ts#L17-L19"
          }
        ]
      }
    ]
  },
  {
    "type": "trace_quote",
    "traceId": "trace",
    "eventId": "0",
    "text": "Order one, then ship it."
  },
  {
    "type": "software_map",
    "mapVersionId": "map-base"
  },
  {
    "type": "software_map",
    "mapVersionId": "map-head"
  }
]
