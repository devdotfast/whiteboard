// Static assets with a hostname redirect to diffr.fast.
// Deployed by .github/workflows/diffr-web.yml; pull requests get preview URLs.
{
  "name": "diffsthatgetyoustiff",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    // Every path is a route of the page: /owner/repo/pull/N, /owner/repo/compare/a...b.
    "not_found_handling": "single-page-application",
  },
  "preview_urls": true,
  "routes": [
    { "pattern": "diffsthatgetyoustiff.com", "custom_domain": true },
    { "pattern": "diffr.fast/*", "zone_name": "diffr.fast" },
  ],
}
