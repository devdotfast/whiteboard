{
  "name": "@dev.fast/diffr",
  "version": "0.1.16",
  "description": "diffr's NDJSON wire contract, validators, and the diffr binary for this platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/whiteboard.git",
    "directory": "diffr/diffr-ts"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "!src/test-binary.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@dev.fast/diffr-darwin-arm64": "0.1.16",
    "@dev.fast/diffr-darwin-x64": "0.1.16",
    "@dev.fast/diffr-linux-arm64": "0.1.16",
    "@dev.fast/diffr-linux-x64": "0.1.16",
    "@dev.fast/diffr-win32-x64": "0.1.16"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
